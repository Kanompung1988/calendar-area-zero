rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only emails listed in members/{email} (added by an admin in the console) can use the app.
    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }
    match /members/{email} {
      allow read: if isMember();
      allow update: if isMember() && request.auth.token.email == email;
      allow create, delete: if false; // console only
    }
    match /items/{id} {
      allow read, write: if isMember();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
