# Firebase Configuration
# Get these values from Firebase Console (Project Settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# --- Daily email digest (server only, set on Vercel) ---
# Firebase console → Project settings → Service accounts → Generate new private key, paste the whole JSON on one line
FIREBASE_SERVICE_ACCOUNT=
# https://resend.com → API Keys
RESEND_API_KEY=
# Sender; use onboarding@resend.dev until the domain is verified in Resend
EMAIL_FROM="Area Zero Calendar <onboarding@resend.dev>"
# Any random string; Vercel Cron sends it as a bearer token
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://calendar.areazeroai.com
